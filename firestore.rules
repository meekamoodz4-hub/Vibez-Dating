rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow get: if request.auth != null
        && request.auth.uid == userId;
      allow list: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow get, list: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'age', 'gender', 'bio', 'interests', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 120
        && request.resource.data.gender is string
        && request.resource.data.gender.size() <= 40
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 200;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /swipes/{swipeId} {
      allow create, update: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && swipeId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.decision in ['like', 'pass']
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'decision', 'createdAt']);
      allow get: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow list: if request.auth != null
        && resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.fromUid == request.auth.uid;
    }

    // Only mutual Likes can create a match.
    match /matches/{matchId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['participants', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && matchId == request.resource.data.participants[0] + '_'
          + request.resource.data.participants[1]
        && get(/databases/$(database)/documents/swipes/$(request.resource.data.participants[0] + '_' + request.resource.data.participants[1])).data.decision == 'like'
        && get(/databases/$(database)/documents/swipes/$(request.resource.data.participants[1] + '_' + request.resource.data.participants[0])).data.decision == 'like';

      allow get, list: if request.auth != null
        && resource.data.participants.hasAny([request.auth.uid]);

      allow update, delete: if false;

      match /messages/{messageId} {
        function isMatchMember() {
          return request.auth != null
            && get(/databases/$(database)/documents/matches/$(matchId)).data.participants.hasAny([request.auth.uid]);
        }

        allow get, list: if isMatchMember();
        allow create: if isMatchMember()
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}